<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main Content with Toolbar and Menu Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Toolbar with menu icon -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorPrimary"
            android:title="Main Activity"
            android:titleTextColor="@android:color/white" />

        <!-- Message TextView below Toolbar -->
        <TextView
            android:id="@+id/discoverMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Discover the food by searching using the following options"
            android:textSize="18sp"
            android:textColor="@android:color/black"
            android:padding="8dp"
            android:gravity="center_horizontal" />

        <!-- Main Activity Layout Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center">

            <!-- Image View to display selected or captured photo -->
            <ImageView
                android:id="@+id/selectedImageView"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginBottom="16dp"
                android:src="@drawable/photoupload"
                android:contentDescription="Selected image"
                android:scaleType="centerCrop" />

            <!-- Button to open gallery and choose photo -->
            <Button
                android:id="@+id/selectPhotoButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Choose Photo" />

            <!-- Button to take a new photo -->
            <Button
                android:id="@+id/takePhotoButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Take Photo"
                android:layout_marginTop="16dp" />

            <!-- Button to upload and search -->
            <Button
                android:id="@+id/uploadButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Upload and Search"
                android:layout_marginTop="16dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Navigation Drawer with Profile and Settings -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:menu="@menu/drawer_menu" />
</androidx.drawerlayout.widget.DrawerLayout>
